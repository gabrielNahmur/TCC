# Nunca versionar tokens, certificados ou chaves reais.
APP_ENV=development
PROVIDER_MODE=mock
DISPENSER_MODE=simulated
DATABASE_PATH=data/tcc.db
AUTHORIZATION_TTL_SECONDS=30
SUPERVISOR_TOKEN=replace-with-a-long-random-development-token
IDEMPOTENCY_HMAC_SECRET=replace-with-an-independent-random-secret-of-32-chars

# Use DISPENSER_MODE=mqtt apenas com o broker e o PICSimLab/ESP32 da bancada.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tcc/bancada
MQTT_DEVICE_ID=esp32-bancada-01
MQTT_PUMP_ID=pump-01
MQTT_ACK_TIMEOUT_SECONDS=3
MQTT_USE_TLS=false

# Reservado para uma futura integração autorizada. O adaptador real NÃO faz
# parte deste protótipo e o modo senatran falha no startup por segurança.
# SENATRAN_BASE_URL=
# SENATRAN_CERT_PATH=
# SENATRAN_KEY_PATH=
